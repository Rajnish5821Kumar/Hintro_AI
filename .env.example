# ============================================================
# Meeting Intelligence Service — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/meeting_intelligence?schema=public"

# ── Authentication ────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── Google Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# ── Telegram Bot ──────────────────────────────────────────────
# Get this token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Default chat ID to send notifications to (can be overridden per action item)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Redis (Optional — for caching) ───────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Cron Jobs ─────────────────────────────────────────────────
# Reminder job schedule (default: every hour)
REMINDER_CRON_SCHEDULE=0 * * * *
REMINDER_JOB_ENABLED=true
